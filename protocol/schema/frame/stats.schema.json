{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://voidwarden.dev/protocol/frame/stats.schema.json",
  "title": "stats (ESP32 → PC)",
  "description": "Alle 30 s (spec.md §4.2). Zeilenlänge ≤ 512 Byte wird auf NDJSON-Ebene erzwungen (check:protocol, Parser; ADR-0002). Additive Felder bleiben v1 (ADR-0002): unbekannte Felder sind erlaubt, werden aber gezählt und geloggt.",
  "type": "object",
  "required": [
    "v",
    "type",
    "fps",
    "heap_free",
    "heap_min",
    "uptime_s",
    "rx_overrun",
    "parse_err"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "const": "stats"
    },
    "fps": {
      "type": "number",
      "minimum": 0
    },
    "heap_free": {
      "type": "integer",
      "minimum": 0
    },
    "heap_min": {
      "type": "integer",
      "minimum": 0
    },
    "uptime_s": {
      "type": "integer",
      "minimum": 0
    },
    "rx_overrun": {
      "type": "integer",
      "minimum": 0
    },
    "parse_err": {
      "type": "integer",
      "minimum": 0
    }
  }
}
