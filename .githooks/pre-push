#!/bin/sh
# Lint und Typecheck vor jedem Push (AGENTS.md: Pflicht vor jedem Commit-Vorschlag).
# Tests und E2E laufen bewusst nicht hier: `npm run gate` / Skill `gates`.
# Reine Branch-Löschungen (`git push --delete`) werden nicht geprüft.
zero=0000000000000000000000000000000000000000
update=0
while read -r _ local_sha _ _; do
  [ "$local_sha" != "$zero" ] && update=1
done
[ "$update" = 1 ] || exit 0
npm run -s lint && npm run -s typecheck
